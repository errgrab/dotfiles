# Interactive
[[ $- != *i* ]] && return

# PATH
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# TMUX + FISH
if command -v tmux >/dev/null 2>&1 \
&& [[ -z "$TMUX" ]] \
&& [[ "$TERM" != "screen" ]]; then
	exec tmux new-session -A -s main
fi
if command -v fish >/dev/null 2>&1; then
	exec fish
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="erikg"
source $ZSH/oh-my-zsh.sh
